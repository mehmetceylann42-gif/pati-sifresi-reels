# Bu dosyayı .env olarak kopyala ve değerleri kendi hesabından doldur.
# .env .gitignore'da; ama BU dosya (.env.example) Git'te izleniyor ve public
# repoya gidiyor — buraya asla gerçek token yazma.
#
# 2026-08-28: Bu dosyada gerçek bir IG_ACCESS_TOKEN duruyordu ve ilk commit'ten
# beri public repodaydı. Placeholder ile değiştirildi. Token'ın kendisi hâlâ
# Git geçmişinde; Meta tarafında iptal edilip yenilenmeden güvenli sayılmaz.
IG_USER_ID=<instagram-user-id>
IG_ACCESS_TOKEN=<instagram-access-token>
IG_API_VERSION=v24.0
IG_API_HOST=graph.instagram.com
